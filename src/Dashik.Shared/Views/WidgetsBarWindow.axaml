<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="Dashik.Shared.Views.WidgetsBarWindow"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Title="Dashik">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Dashik.Shared/Resources/FontAwesome.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Color x:Key="ContainerBackground">#FF778899</Color> <!-- DarkSlateBlue -->
    </Window.Resources>

    <StackPanel Orientation="Horizontal">

    </StackPanel>
</Window>
