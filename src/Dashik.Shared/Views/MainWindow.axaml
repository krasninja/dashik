<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="300"
        Width="300"
        Height="300"
        WindowStartupLocation="CenterScreen"
        x:Class="Dashik.Shared.Views.MainWindow"
        CanMaximize="False"
        CanResize="False"
        IsVisible="False"
        Title="Dashik">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center">Welcome to Dashik!</TextBlock>
        <TextBlock HorizontalAlignment="Center" FontSize="8" FontStyle="Italic">
            The window is not intended to be visible.
        </TextBlock>
    </StackPanel>
</Window>
